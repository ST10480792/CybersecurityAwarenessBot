<Window x:Class="CybersecurityAwarenessBot_Part2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cybersecurity Awareness Assistant"
        Height="750"
        Width="1050"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E2F">

    <Grid Margin="15">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="#2A2A40"
                CornerRadius="10"
                Padding="15"
               Margin="0,0,0,25">

            <StackPanel>

                <TextBlock Text="CYBERSECURITY AWARENESS ASSISTANT"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="Cyan"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Helping South Africans Stay Safe Online"
                           FontSize="14"
                           Foreground="LightGray"
                           HorizontalAlignment="Center"
                           Margin="0,5,0,0"/>

            </StackPanel>
        </Border>

        <!-- ASCII Art -->
        <Border Grid.Row="1"
                Background="#2A2A40"
                CornerRadius="10"
               Padding="20"
               Margin="0,0,0,25">

            <TextBlock FontFamily="Consolas"
                       Foreground="Yellow"
                       FontSize="14"
                       TextAlignment="Center"
                       Text="      .----------.
     /          / \
    /          /   \
   /__________/     \
   |   [SAFE] |      |
   |          |      |
   \          /     /
    \        /     /
     \______/_____/"/>
        </Border>

        <!-- Chat Area -->
        <Border Grid.Row="2"
                Background="#2A2A40"
                CornerRadius="10"
               Padding="20"
               Margin="0,0,0,25">

            <ScrollViewer x:Name="ChatScrollViewer"
              VerticalScrollBarVisibility="Auto">
                
                <TextBox x:Name="ChatDisplay"
                         Background="#2A2A40"
                         Foreground="White"
                         FontSize="16"
                         BorderThickness="0"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"/>

            </ScrollViewer>
        </Border>

        <!-- Input Area -->
        <Grid Grid.Row="3">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="UserInputBox"
             Grid.Column="0"
             Height="40"
             FontSize="16"
             Margin="0,0,10,0"
             KeyDown="UserInputBox_KeyDown"/>

            <Button x:Name="SendButton"
            Grid.Column="1"
            Content="Send"
            FontSize="16"
            Height="40"
            Margin="0,0,10,0"
            Background="Cyan"
            Click="SendButton_Click"/>

            <Button x:Name="TaskButton"
            Grid.Column="2"
            Content="Tasks"
            FontSize="16"
            Height="40"
            Background="MediumSeaGreen"
            Click="TaskButton_Click"/>
            
            <Button x:Name="QuizButton"
        Grid.Column="3"
        Content="Quiz"
        FontSize="16"
        Height="40"
        Background="Orange"
        Click="QuizButton_Click"/>

            <Button x:Name="ExitButton"
        Grid.Column="4"
        Content="Exit"
        FontSize="16"
        Height="40"
        Background="Crimson"
        Click="ExitButton_Click"/>

        </Grid>

    </Grid>
</Window>